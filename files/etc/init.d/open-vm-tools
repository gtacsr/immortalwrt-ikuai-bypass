#!/bin/sh /etc/rc.common
# open-vm-tools 启动脚本
# 背景：ImmortalWrt 25.12 的 x86_64 源里已移除 open-vm-tools，
#       本镜像在构建时从 OpenWrt 24.10.4 x86_64 源注入程序本体，
#       依赖库(libtirpc/libmspack/libdnet)放在私有目录，避免覆盖系统库。
START=90
STOP=10
USE_PROCD=1

start_service() {
	# vmci / vsock 是 vmtoolsd 与 ESXi 通信的基础（尽力加载，失败不阻断）
	modprobe vmw_vmci 2>/dev/null
	modprobe vmw_vsock_vmci_transport 2>/dev/null
	modprobe vmwgfx 2>/dev/null

	procd_open_instance
	procd_set_param command /usr/bin/vmtoolsd
	procd_set_param env LD_LIBRARY_PATH=/usr/lib/vmware-tools-libs
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
