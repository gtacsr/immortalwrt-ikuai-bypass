#!/bin/sh /etc/rc.common

START=99
STOP=10

BIN_PATH="/opt/ikuai-bypass/ikuai-bypass"
CONFIG_PATH="/opt/ikuai-bypass/config.yml"
LOCAL_CACHE="/opt/ikuai-bypass/install-cache"
CACHE_DIR="/tmp/ikuai-bypass-install-cache"
IPV6_PIDFILE="/var/run/ikuai-bypass-ipv6.pid"
IPV6_LOG="/tmp/ikuai-bypass-ipv6.log"

# 分流模块：ii = 自定义运营商/域名分流 + ip分组/端口分流（下一跳）
# 可选：ispdomain / ipgroup / ipv6group / ii / ip
IKB_MODULE="${IKB_MODULE:-ii}"
# IPv6 分组是否跟随服务自动同步（1=是）
IKB_RUN_IPV6="${IKB_RUN_IPV6:-1}"
# IPv6 分组的同步周期（秒，默认 24 小时）
IKB_IPV6_INTERVAL="${IKB_IPV6_INTERVAL:-86400}"

warmup_cache() {
    if [ -d "${LOCAL_CACHE}" ]; then
        mkdir -p "${CACHE_DIR}/install-file"
        cp -rf "${LOCAL_CACHE}/install.sh" "${CACHE_DIR}/install.sh" 2>/dev/null || true
        cp -rf "${LOCAL_CACHE}/install-file/common.sh" "${CACHE_DIR}/install-file/common.sh" 2>/dev/null || true
        chmod +x "${CACHE_DIR}/install.sh" "${CACHE_DIR}/install-file/common.sh" 2>/dev/null || true
        date +%s > "${CACHE_DIR}/.stamp" 2>/dev/null || true
    fi
}

# 为什么单独跑：v4.2.0 的 -m 只有 ispdomain/ipgroup/ipv6group/ii/ip 五个值，
# 没有「ii + IPv6」这种组合（4.4.x 才有 -m iip），所以 IPv6 分组用独立循环同步。
start_ipv6_loop() {
    [ "${IKB_RUN_IPV6}" = "0" ] && return 0
    [ -f "${IPV6_PIDFILE}" ] && kill "$(cat "${IPV6_PIDFILE}" 2>/dev/null)" 2>/dev/null
    (
        while :; do
            ${BIN_PATH} -r once -m ipv6group -c ${CONFIG_PATH} > ${IPV6_LOG} 2>&1
            sleep "${IKB_IPV6_INTERVAL}"
        done
    ) &
    echo $! > "${IPV6_PIDFILE}"
}

start() {
    warmup_cache
    if [ -x "${BIN_PATH}" ] && [ -f "${CONFIG_PATH}" ]; then
        # 避免重复拉起进程
        if pidof ikuai-bypass >/dev/null 2>&1; then
            return 0
        fi
        # Why/为什么: v4.2.0 的分流模块由命令行 -m 决定（默认 ispdomain），
        # 不传的话 ip 分组 / 下一跳规则根本不会被推送。ii = ispdomain + ipgroup。
        ${BIN_PATH} -r cronAft -m "${IKB_MODULE}" -c ${CONFIG_PATH} > /dev/null 2>&1 &
        start_ipv6_loop
    fi
}

stop() {
    if [ -f "${IPV6_PIDFILE}" ]; then
        kill "$(cat "${IPV6_PIDFILE}" 2>/dev/null)" 2>/dev/null
        rm -f "${IPV6_PIDFILE}"
    fi
    killall -q -9 ikuai-bypass 2>/dev/null
}

restart() {
    stop
    sleep 1
    start
}
