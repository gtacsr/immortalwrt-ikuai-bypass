#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

BIN_PATH="/opt/ikuai-bypass/ikuai-bypass"
CONFIG_PATH="/opt/ikuai-bypass/config.yml"
LOCAL_CACHE="/opt/ikuai-bypass/install-cache"
CACHE_DIR="/tmp/ikuai-bypass-install-cache"
MAIN_LOG="/tmp/ikuai-bypass-main.log"
IPV6_LOG="/tmp/ikuai-bypass-ipv6.log"

# 分流模块：ii = 自定义运营商/域名分流 + ip分组/端口分流（下一跳）
# 可选：ispdomain / ipgroup / ipv6group / ii / ip
IKB_MODULE="${IKB_MODULE:-ii}"
# IPv6 分组是否跟随服务自动同步（1=是，0=关）
IKB_RUN_IPV6="${IKB_RUN_IPV6:-1}"
# IPv6 分组的同步周期（秒，默认 24 小时）
IKB_IPV6_INTERVAL="${IKB_IPV6_INTERVAL:-86400}"

warmup_cache() {
    if [ -d "${LOCAL_CACHE}" ]; then
        mkdir -p "${CACHE_DIR}/install-file"
        cp -rf "${LOCAL_CACHE}/install.sh" "${CACHE_DIR}/install.sh" 2>/dev/null || true
        cp -rf "${LOCAL_CACHE}/install-file/common.sh" "${CACHE_DIR}/install-file/common.sh" 2>/dev/null || true
        chmod +x "${CACHE_DIR}/install.sh" "${CACHE_DIR}/install-file/common.sh" 2>/dev/null || true
        date +%s > "${CACHE_DIR}/.stamp" 2>/dev/null || true
    fi
}

# Why/为什么用 procd：早先用裸 & 起守护进程，开机收尾阶段会被回收（重启后 19001
# 不监听，手动 start 正常）。procd 托管可活过启动收尾并在异常退出时自动拉起。
start_service() {
    warmup_cache

    [ -x "${BIN_PATH}" ] || return 1
    [ -f "${CONFIG_PATH}" ] || return 1

    # 主实例：分流同步守护进程（同时提供 19001 面板）
    # Why/为什么包一层 while：实测直接由 procd 拉起二进制，开机收尾阶段该实例会被
    # SIGTERM 收尾（面板不监听）；包成常驻 shell 后与 ipv6 实例同样存活，且二进制
    # 若异常退出会被立刻重启，等于免费的自愈。
    procd_open_instance main
    procd_set_param command /bin/sh -c \
        "while :; do ${BIN_PATH} -r cronAft -m ${IKB_MODULE} -c ${CONFIG_PATH} >> ${MAIN_LOG} 2>&1; sleep 5; done"
    procd_set_param respawn 3600 5 5
    procd_close_instance

    # IPv6 实例：v4.2.0 没有「ii+IPv6」组合，单独循环，开机先跑一次再按周期
    if [ "${IKB_RUN_IPV6}" != "0" ]; then
        procd_open_instance ipv6
        procd_set_param command /bin/sh -c \
            "while :; do ${BIN_PATH} -r once -m ipv6group -c ${CONFIG_PATH} > ${IPV6_LOG} 2>&1; sleep ${IKB_IPV6_INTERVAL}; done"
        procd_set_param respawn 3600 5 5
        procd_close_instance
    fi
}
