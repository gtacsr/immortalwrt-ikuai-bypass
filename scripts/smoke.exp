#!/usr/bin/expect -f
# 用法: smoke.exp <raw.img> [-enable-kvm -cpu host | -accel tcg -cpu max]
set timeout 420
set img [lindex $argv 0]
set accelargs [lrange $argv 1 end]
log_user 1

spawn qemu-system-x86_64 {*}$accelargs -m 2048 -smp 2 \
  -drive file=$img,format=raw,if=virtio \
  -netdev user,id=n0 -device virtio-net-pci,netdev=n0 \
  -nographic -no-reboot

# OpenWrt 的串口是 inittab askfirst：先回车激活控制台，再登录（root 空密码）
expect {
  -re "press Enter" { send "\r"; exp_continue }
  -re "login:"      { send "root\r"; exp_continue }
  -re "Password:"   { send "\r"; exp_continue }
  -re "# $"         { puts "\n###SHELL_OK###" }
  eof               { puts "\n###EXIT_BEFORE_SHELL###"; exit 2 }
  timeout           { puts "\n###TIMEOUT_SHELL###"; exit 3 }
}

set timeout 90
set cmds {
  "echo ===SMOKE_START==="
  "cat /proc/cmdline"
  "ls -la /etc/uci-defaults/ 2>&1"
  "ls -la /etc/config/ 2>&1"
  "uci show network 2>&1 | head -n 25"
  "cat /etc/config/system 2>&1 | head -n 15"
  "mount | grep -E ' / |/tmp|overlay'"
  "command -v opkg; command -v apk; ls /usr/lib/opkg 2>&1 | head -n 3; ls /lib/apk/db 2>&1 | head -n 3"
  "apk info 2>/dev/null | tr '\\n' ' ' | cut -c1-700"
  "opkg list-installed 2>/dev/null | grep -Ei 'openclash|argon|dnsmasq|ikuai' "
  "ls -l /etc/init.d/ikuai-bypass /etc/uci-defaults/99-custom-setup.sh 2>&1"
  "ls -ld /tmp; ls -la /tmp | head -n 10"
  "dmesg | grep -iE 'uci-defaults|overlay|first boot' "
  "uci get network.lan.ipaddr"
  "uci get luci.main.mediaurlbase"
  "echo ===SMOKE_END==="
}
foreach c $cmds {
  send "$c\r"
  expect -re "# $" {}
}

send "poweroff\r"
expect eof
