#!/usr/bin/expect -f
# 用法: smoke.exp <raw.img> [-enable-kvm -cpu host | -accel tcg -cpu max]
# 两个必须处理的点：
#  1) 串口是 inittab askfirst：先回车激活控制台，再按需登录（root 空密码）
#  2) 控制台 shell 在 rcS 之前就到手，必须轮询等 uci-defaults provisioning 落地后再取样
set timeout 900
set img [lindex $argv 0]
set accelargs [lrange $argv 1 end]
log_user 1

proc run {cmd} {
  send -- $cmd
  send "\r"
  expect -re "# $" {}
}

spawn qemu-system-x86_64 {*}$accelargs -m 2048 -smp 2 \
  -drive file=$img,format=raw,if=virtio \
  -netdev user,id=n0 -device e1000,netdev=n0 \
  -nographic -no-reboot

expect {
  -re "press Enter" { send "\r"; exp_continue }
  -re "login:"      { send "root\r"; exp_continue }
  -re "Password:"   { send "\r"; exp_continue }
  -re "# $"         { puts "\n###SHELL_OK###" }
  eof               { puts "\n###EXIT_BEFORE_SHELL###"; exit 2 }
  timeout           { puts "\n###TIMEOUT_SHELL###"; exit 3 }
}

set timeout 120
run "echo ===SMOKE_START==="
run "cat /proc/uptime"

# 等首次开机 provisioning：LAN 变成 192.168.123.2/24 即视为完成（最多约 3 分钟 guest 时间）
set timeout 900
run {i=0; while [ $i -lt 60 ]; do v=$(uci -q get network.lan.ipaddr); [ "$v" = "192.168.123.2/24" ] && { echo BOOT_PROVISIONED_I=$i; break; }; [ $((i % 5)) -eq 0 ] && echo "poll i=$i ip=$v"; i=$((i+1)); sleep 3; done; echo WAIT_LOOP_END ip=$(uci -q get network.lan.ipaddr)}

set timeout 120
run "cat /proc/uptime"
run "ls -l /etc/uci-defaults/99-custom-setup.sh 2>&1"
run "cat /root/setup.log 2>&1 | tail -n 30"
run "ls -l /root/setup.log"
run "df -h / | tail -n 2"
run "uci show network | grep -E 'lan\\.(ipaddr|gateway|dns|proto)'"
run "uci get dhcp.lan.ignore"
run "grep -n uci-defaults /etc/init.d/boot | head -5"
run "logread 2>/dev/null | grep -iE 'uci-default|setup' | head -8"
run "ls -la /tmp/.uci-defaults 2>&1 | head -5"
run "sleep 20"; run "ls /sys/class/net"
run "dmesg | grep -iE 'e1000|PRO/1000' | tail -n 3"
run "ip -4 addr show br-lan | grep inet"
run "ip -4 route"
run "/etc/init.d/ikuai-bypass enabled && echo IKUAIBYPASS_ENABLED"
run {ps | grep -c "[i]kuai-bypass"}
run "grep -E 'nexthop|ikuai-url' /opt/ikuai-bypass/config.yml"
run "cat /opt/ikuai-bypass/.version"
run "grep -cE '^  - name:' /opt/ikuai-bypass/config.yml"
run "grep -E '^(mode|run-mode|proxy|MaxNumberOfOneRecords|ikuai-url-ignore-cert):' /opt/ikuai-bypass/config.yml || echo NO_44_ONLY_KEYS"
run "grep -o IKB_MODULE /etc/init.d/ikuai-bypass | head -n 1"
run {/opt/ikuai-bypass/ikuai-bypass -r once -m ii -c /opt/ikuai-bypass/config.yml > /tmp/ikb.out 2>&1 & sleep 8; killall -q ikuai-bypass; head -n 8 /tmp/ikb.out}
run "grep -c . /tmp/ikb.out"
run "grep -n 'enable-update' /opt/ikuai-bypass/config.yml"
run "curl -s -o /dev/null -w PANEL=%{http_code} http://127.0.0.1:19001/"
run "curl -s -o /dev/null -w CONFIG_API=%{http_code} http://127.0.0.1:19001/api/config"
run "cat /var/run/ikuai-bypass-ipv6.pid"
run "head -n 6 /tmp/ikuai-bypass-ipv6.log"
run {kill -0 $(cat /var/run/ikuai-bypass-ipv6.pid) && echo IPV6_LOOP_ALIVE}
run "/usr/libexec/ikuai-bypass-openwrt install 2>&1 | head -n 3"
run "/usr/libexec/ikuai-bypass-openwrt luci-update 2>&1 | head -n 3"
run "IKB_ALLOW_UPGRADE=0 /usr/libexec/ikuai-bypass-openwrt update 2>&1 | head -n 2"
run "grep -c display:none /usr/lib/lua/luci/view/ikuai_bypass/status.htm"
run "grep -o 'ikb-install-btn,button' /usr/lib/lua/luci/view/ikuai_bypass/status.htm | head -n 1"
run "ls -l /opt/ikuai-bypass/ikuai-bypass"
run "/opt/ikuai-bypass/ikuai-bypass -v 2>&1 | head -n 2; /opt/ikuai-bypass/ikuai-bypass --version 2>&1 | head -n 2"
run "grep -E 'port|user|enable' /opt/ikuai-bypass/config.yml | head -n 6"
run "sleep 6; (ss -ltn 2>/dev/null || netstat -ltn 2>/dev/null) | grep 19001 || echo NO_PORT_19001"
run "curl -s -m 8 -o /dev/null -w 'PANEL_HTTP=%{http_code}\n' http://127.0.0.1:19001/ || echo PANEL_CURL_FAIL"
run "apk info -e luci-app-openclash && echo OC_PKG_OK"
run "ls /lib/modules/*/e1000e.ko /lib/modules/*/e1000.ko /lib/modules/*/igb.ko /lib/modules/*/vmxnet3.ko 2>&1"
run "ls -l /usr/bin/vmtoolsd /usr/lib/vmware-tools-libs 2>&1 | head -n 10"
run "ls -l /usr/lib/vmware-tools-libs | head -n 14"
run "LD_LIBRARY_PATH=/usr/lib/vmware-tools-libs /usr/bin/vmtoolsd --version 2>&1; echo VMTOOLSD_RC=$?"
run "/etc/init.d/open-vm-tools enabled && echo VMTOOLS_ENABLED"
run {ps | grep -c "[v]mtoolsd"}
run "apk info -e open-vm-tools && echo VMTOOLS_OK"
run "ls -l /etc/init.d/open-vm-tools 2>&1"
run "apk info | tr '\\n' ' ' | cut -c1-600"
run "/etc/openclash/core/clash_meta -v"
run "uci get luci.main.mediaurlbase"
run "uname -n"
run "echo ===SMOKE_END==="

set timeout 180
send "poweroff\r"
expect eof
